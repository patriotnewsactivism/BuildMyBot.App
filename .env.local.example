# ============================================
# LOCAL DEVELOPMENT ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.local and fill in your actual values
# .env.local is git-ignored and safe for local development

# ============================================
# SUPABASE (Required)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://qjwwkcoredotrjtstigt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-actual-anon-key-here

# ============================================
# OPENAI (Required for AI features)
# ============================================
# ⚠️ For local dev only - in production, set via Supabase secrets
VITE_OPENAI_API_KEY=your-openai-key-here
NEXT_PUBLIC_OPENAI_API_KEY=your-openai-key-here

# ============================================
# OPTIONAL SERVICES
# ============================================
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
