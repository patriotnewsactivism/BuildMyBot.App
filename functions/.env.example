# Required for calling OpenAI through the proxy
OPENAI_API_KEY=your-openai-api-key
# OPENAI_API_BASE=https://api.openai.com/v1/

# Configure a non-OpenAI third-party provider (optional)
GENERIC_PROXY_BASE_URL=https://api.example.com
GENERIC_API_KEY=your-generic-api-key
# Comma-separated list of allowed path prefixes (required when enabling the generic provider)
GENERIC_ALLOWED_PATH_PREFIXES=/v1/
