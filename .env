# ============================================
# NEXT.JS ENVIRONMENT VARIABLES - LOCAL DEVELOPMENT
# ============================================
# ⚠️ IMPORTANT: Replace these placeholder values with real credentials
# Copy this file to .env.local for local development (git-ignored)
# Add real values in Vercel/hosting dashboard for production

# ============================================
# SUPABASE (Required)
# ============================================
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://qjwwkcoredotrjtstigt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# OPENAI (Required for AI features)
# ============================================
# Get your key from: https://platform.openai.com/api-keys
# ⚠️ CRITICAL: NEVER commit real API keys to git
# Set this in Supabase Edge Function secrets only
# This should be empty in git - set via: supabase secrets set OPENAI_API_KEY=your-key
OPENAI_API_KEY=

# ============================================
# POSTHOG ANALYTICS (Optional - can leave as-is for development)
# ============================================
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ============================================
# SENTRY ERROR TRACKING (Optional - can leave as-is for development)
# ============================================
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# ============================================
# STRIPE (Optional - for billing features)
# ============================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================
# SETUP INSTRUCTIONS
# ============================================
# 1. Create a Supabase project: https://app.supabase.com
# 2. Apply migrations: cd supabase && supabase db push
# 3. Get your Supabase URL and anon key from project settings
# 4. Get OpenAI API key: https://platform.openai.com/api-keys
# 5. Replace the placeholder values above with real credentials
# 6. Restart your dev server: npm run dev
