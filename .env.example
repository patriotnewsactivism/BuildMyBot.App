# BuildMyBot Environment Configuration
# Copy this file to .env.local and fill in your values

# =============================================================================
# FRONTEND ENVIRONMENT VARIABLES (NEXT_PUBLIC_ prefix exposes to browser)
# =============================================================================

# Supabase Configuration (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Sentry Error Tracking (Optional)
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
NEXT_PUBLIC_ENVIRONMENT=development

# PostHog Product Analytics (Optional)
NEXT_PUBLIC_POSTHOG_API_KEY=phc_your_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Stripe Publishable Key (Frontend - safe to expose)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# =============================================================================
# SERVER-SIDE ONLY (Never exposed to browser)
# =============================================================================

# Application
PORT=8080

# Database Direct Connection (for server-side operations)
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Local content scraper (optional)
# LOCAL_SCRAPER_PATH=/path/to/scrape_cli.py
# LOCAL_SCRAPER_PYTHON=python

# Supabase service credentials (used by server routes / scripts)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_AI_API_KEY=AIzaSy...

# =============================================================================
# SUPABASE EDGE FUNCTION SECRETS
# Set these via: supabase secrets set KEY=value
# =============================================================================

# Supabase (required by edge functions)
# supabase secrets set SUPABASE_URL=https://your-project.supabase.co
# supabase secrets set SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI / Anthropic / Gemini (for AI chat and marketing features)
# supabase secrets set OPENAI_API_KEY=sk-...
# supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# supabase secrets set GOOGLE_AI_API_KEY=AIzaSy...

# Stripe (for billing)
# supabase secrets set STRIPE_SECRET_KEY=sk_live_...
# supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...
# supabase secrets set STRIPE_PRICE_STARTER=price_...
# supabase secrets set STRIPE_PRICE_PROFESSIONAL=price_...
# supabase secrets set STRIPE_PRICE_EXECUTIVE=price_...
# supabase secrets set STRIPE_PRICE_ENTERPRISE=price_...

# Twilio (for phone agent)
# supabase secrets set TWILIO_ACCOUNT_SID=AC...
# supabase secrets set TWILIO_AUTH_TOKEN=...
# supabase secrets set TWILIO_PHONE_NUMBER=+1...

# Cartesia Voice AI (for phone agent TTS)
# supabase secrets set CARTESIA_API_KEY=sk_car_...
