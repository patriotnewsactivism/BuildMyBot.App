# ============================================
# NEXT.JS ENVIRONMENT VARIABLES
# ============================================
# Use NEXT_PUBLIC_ prefix for client-side variables
# Use no prefix for server-side only variables

# ============================================
# SUPABASE (Required)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ============================================
# OPENAI (Required for AI features)
# ============================================
# Server-side only - used in /api/ai route to protect the key
OPENAI_API_KEY=sk-proj-...

# ============================================
# SENTRY ERROR TRACKING (Optional)
# ============================================
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# Build-time only (for source maps upload)
SENTRY_ORG=your-org
SENTRY_PROJECT=buildmybot-app
SENTRY_AUTH_TOKEN=your-auth-token

# ============================================
# POSTHOG ANALYTICS (Optional)
# ============================================
NEXT_PUBLIC_POSTHOG_KEY=phc_your_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ============================================
# STRIPE (Optional - for billing)
# ============================================
# Client-side publishable key (safe to expose)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Server-side secrets (NEVER expose to client)
# These should be set in Vercel/hosting dashboard or Supabase secrets
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================
# LEGACY (Will be removed - DO NOT USE)
# ============================================
# VITE_* variables are deprecated - use NEXT_PUBLIC_* instead
# VITE_FIREBASE_API_KEY=... (being phased out)
