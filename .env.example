# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# For Vercel/Next.js deployments
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Sentry Error Tracking & Performance Monitoring
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
VITE_SENTRY_ORG=your-org
VITE_SENTRY_PROJECT=buildmybot-app
VITE_SENTRY_AUTH_TOKEN=your-auth-token
VITE_ENVIRONMENT=production

# For Next.js deployments
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
NEXT_PUBLIC_ENVIRONMENT=production

# PostHog Product Analytics
VITE_POSTHOG_API_KEY=phc_your_api_key
VITE_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_POSTHOG_API_KEY=phc_your_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Stripe (Frontend - Publishable Key Only)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# OpenAI (DO NOT PUT IN FRONTEND - Edge Functions Only)
# OPENAI_API_KEY=sk-... (set via supabase secrets set)

# Stripe Secret (DO NOT PUT IN FRONTEND - Edge Functions Only)
# STRIPE_SECRET_KEY=sk_live_... (set via supabase secrets set)
# STRIPE_WEBHOOK_SECRET=whsec_... (set via supabase secrets set)

# Twilio Configuration (Edge Functions Only - DO NOT expose to frontend)
# TWILIO_ACCOUNT_SID=AC... (set via supabase secrets set)
# TWILIO_AUTH_TOKEN=... (set via supabase secrets set)
# TWILIO_PHONE_NUMBER=+1... (your Twilio phone number)

# Cartesia Voice AI (Edge Functions Only)
# CARTESIA_API_KEY=... (set via supabase secrets set)
