# Public browser configuration (values are embedded in the frontend build)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Internal Base44 Superagent ───────────────────────────────────────────────
# SERVER-SIDE ONLY. Never prefix the Base44 key with VITE_ or NEXT_PUBLIC_.
# Rotate any key that has appeared in chat, screenshots, logs, or source code.
BASE44_SUPERAGENT_API_KEY=
BASE44_SUPERAGENT_ID=6a515f4e071e32fc10378575
BASE44_SUPERAGENT_TIMEOUT_MS=45000

# Comma-separated Supabase account emails authorized to call /api/base44-agent.
# The endpoint fails closed when this is empty.
BASE44_ALLOWED_EMAILS=

# Server-side Supabase auth verification. These can also be supplied through
# NEXT_PUBLIC_SUPABASE_URL/NEXT_PUBLIC_SUPABASE_ANON_KEY when that is how the
# deployment is already configured; the anon key is public by design.
SUPABASE_URL=
SUPABASE_ANON_KEY=
